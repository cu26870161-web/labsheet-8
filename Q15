#include <iostream>
using namespace std;

class Shape
{
public:
    virtual double area() = 0;
};

class Circle : public Shape
{
    double radius;

public:
    Circle(double r)
    {
        radius = r;
    }

    double area()
    {
        return 3.14159 * radius * radius;
    }
};

class Rectangle : public Shape
{
    double length, width;

public:
    Rectangle(double l, double w)
    {
        length = l;
        width = w;
    }

    double area()
    {
        return length * width;
    }
};

int main()
{
    Circle c(5);
    Rectangle r(4, 6);

    cout << "Area of circle: " << c.area() << endl;

    cout << "Area of rectangle: " << r.area() << endl;

    return 0;
}
