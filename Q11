#include <iostream>
using namespace std;

class Car
{
public:
    string brand;
    float price;

    void input()
    {
        cout << "Enter car brand: ";
        cin >> brand;

        cout << "Enter car price: ";
        cin >> price;
    }

    void display()
    {
        cout << "Brand: " << brand << endl;
        cout << "Price: " << price << endl;
    }
};

int main()
{
    Car c1, c2;

    cout << "Enter first car details:\n";
    c1.input();

    cout << "\nEnter second car details:\n";
    c2.input();

    cout << "\nFirst Car:\n";
    c1.display();

    cout << "\nSecond Car:\n";
    c2.display();

    return 0;
}
